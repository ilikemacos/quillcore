{
	"schemaVersion": 1,
	"id": "quillcore",
	"version": "${version}",
	"name": "QuillCore",
	"description": "One core. Smoother worlds. Fabric optimization suite for Minecraft 1.21.8 \u2014 Quill Logic throttles, Quill Render cutoffs, honest upscale stubs until a safe framebuffer hook exists.",
	"authors": [
		"ChopsticksHQ",
		"ilikemacos"
	],
	"contact": {
		"homepage": "https://chopstickshq.com/",
		"sources": "https://github.com/ilikemacos/quillcore",
		"issues": "https://github.com/ilikemacos/quillcore/issues"
	},
	"license": "MIT",
	"icon": "assets/quillcore/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.chopstickshq.quillcore.common.QuillCore"
		],
		"client": [
			"com.chopstickshq.quillcore.client.QuillCoreClient"
		],
		"modmenu": [
			"com.chopstickshq.quillcore.client.QuillCoreModMenu"
		]
	},
	"mixins": [
		"quillcore.mixins.json",
		"quillcore.memory.mixins.json",
		"quillcore.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.8",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"cloth-config": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://chopstickshq.com/"
			}
		}
	}
}
